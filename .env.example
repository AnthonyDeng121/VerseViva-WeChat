VERSEVIVA_ENV=development
VERSEVIVA_API_PREFIX=/api/v1
VERSEVIVA_DATA_DIR=./data
VERSEVIVA_WEB_DIST_DIR=./web/dist
VERSEVIVA_CORS_ORIGINS=http://localhost:5173
VERSEVIVA_MAX_UPLOAD_SIZE_BYTES=104857600
VERSEVIVA_MAX_RECORDING_SIZE_BYTES=104857600
VERSEVIVA_AUTO_RUN_ANALYSIS_PIPELINE=true
# Server-only WeChat login. Never copy AppSecret into miniprogram/.
VERSEVIVA_WECHAT_LOGIN_ENABLED=false
VERSEVIVA_WECHAT_APP_ID=
VERSEVIVA_WECHAT_APP_SECRET=
VERSEVIVA_WECHAT_TOKEN_TTL_SECONDS=7200
VERSEVIVA_WECHAT_LOGIN_TIMEOUT_SECONDS=10
VERSEVIVA_DEMUCS_EXECUTABLE=.venv-demucs/bin/demucs
VERSEVIVA_DEMUCS_MODEL=htdemucs
VERSEVIVA_WHISPERX_EXECUTABLE=.venv-whisperx/bin/whisperx
VERSEVIVA_WHISPERX_MODEL=small
VERSEVIVA_WHISPERX_DEVICE=cpu
VERSEVIVA_WHISPERX_COMPUTE_TYPE=int8
VERSEVIVA_FFPROBE_EXECUTABLE=ffprobe
VERSEVIVA_FFMPEG_EXECUTABLE=ffmpeg
VERSEVIVA_LYRICS_PROVIDER=lrclib
VERSEVIVA_LRCLIB_BASE_URL=https://lrclib.net
VERSEVIVA_LRCLIB_TIMEOUT_SECONDS=10
VERSEVIVA_LRCLIB_MIN_MATCH_SCORE=0.78
VERSEVIVA_LANGUAGE_ANALYSIS_PROVIDER=disabled
VERSEVIVA_GEMINI_API_KEY=
VERSEVIVA_GEMINI_MODEL=gemini-3.8-flash
VERSEVIVA_PRACTICE_ACOUSTIC_PROVIDER=gemini
VERSEVIVA_PRACTICE_ISSUE_CONFIDENCE_THRESHOLD=0.65
VERSEVIVA_GLM_API_KEY=
VERSEVIVA_GLM_MODEL=glm-4.7-flash
VERSEVIVA_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VERSEVIVA_GLM_TIMEOUT_SECONDS=45
# Reserved for the later standalone Gemini-compatible worker.
VERSEVIVA_LANGUAGE_WORKER_URL=
VERSEVIVA_LANGUAGE_WORKER_TOKEN=

