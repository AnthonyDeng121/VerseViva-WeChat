# Server-only template. Copy locally; never commit actual secrets.
VERSEVIVA_ENVIRONMENT=production
VERSEVIVA_DATA_DIR=/app/data
VERSEVIVA_WECHAT_LOGIN_ENABLED=true
VERSEVIVA_WECHAT_APP_ID=wx18a40d3837dc23ff
VERSEVIVA_WECHAT_APP_SECRET=
VERSEVIVA_GEMINI_API_KEY=
VERSEVIVA_LANGUAGE_ANALYSIS_PROVIDER=gemini
VERSEVIVA_RESOURCE_LIMITS_ENABLED=true
VERSEVIVA_RELEASE_REVIEW_REQUIRED=true
VERSEVIVA_REVIEW_LOGIN_ENABLED=false
# Optional review-only credentials: provision on the server; never commit passwords.
# VERSEVIVA_REVIEW_USERNAME=
# VERSEVIVA_REVIEW_PASSWORD_HASH=
# VERSEVIVA_REVIEW_LOGIN_EXPIRES_AT=0
VERSEVIVA_RELEASE_REVIEW_FILE=/app/data/wechat-release-review.json
VERSEVIVA_RESOURCE_WECHAT_ONLY=true
VERSEVIVA_MAX_UPLOAD_SIZE_BYTES=104857600
VERSEVIVA_MAX_RECORDING_SIZE_BYTES=104857600
VERSEVIVA_RESOURCE_UPLOADS_PER_MINUTE=5
VERSEVIVA_RESOURCE_UPLOADS_PER_DAY=30
VERSEVIVA_RESOURCE_AI_PER_MINUTE=3
VERSEVIVA_RESOURCE_AI_PER_DAY=30
VERSEVIVA_RESOURCE_OWNER_BYTES=1073741824
VERSEVIVA_RESOURCE_MIN_FREE_BYTES=1073741824
VERSEVIVA_RESOURCE_MAX_PENDING_ANALYSIS=8
VERSEVIVA_RESOURCE_MAX_SONG_SECONDS=600
VERSEVIVA_RESOURCE_MAX_TAKE_SECONDS=600
